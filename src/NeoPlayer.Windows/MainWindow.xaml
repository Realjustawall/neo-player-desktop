<Window x:Class="NeoPlayer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NeoPlayer.Windows.Models"
        Title="NEO Player" Width="1240" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="98"/></Grid.RowDefinitions>

    <Border Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource NeoPanel}" CornerRadius="18" Padding="12" Margin="0,0,12,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="NEO" FontSize="30" FontWeight="Bold" Margin="10,8,10,18"/>
          <Button Content="{DynamicResource Home}" Command="{Binding HomeCommand}" HorizontalContentAlignment="Left"/>
          <Button Content="{DynamicResource Search}" Command="{Binding SearchPageCommand}" HorizontalContentAlignment="Left"/>
          <Button Content="{DynamicResource Library}" Command="{Binding LibraryCommand}" HorizontalContentAlignment="Left"/>
          <Button Content="Playlists" Command="{Binding PlaylistsPageCommand}" HorizontalContentAlignment="Left"/>
          <Button Content="Queue" Command="{Binding QueuePageCommand}" HorizontalContentAlignment="Left"/>
          <Button Content="Lyrics" Command="{Binding LyricsPageCommand}" HorizontalContentAlignment="Left"/>
          <Button Content="{DynamicResource Settings}" Command="{Binding SettingsCommand}" HorizontalContentAlignment="Left"/>
          <Button Content="Compact player" Click="OpenCompact_Click" HorizontalContentAlignment="Left" Margin="4,18,4,4"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource NeoMuted}" TextWrapping="Wrap" Margin="10"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Grid.Row="0">
      <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="12,4,12,18">
          <TextBlock Text="NEO Player Desktop" Foreground="{DynamicResource NeoMuted}" FontSize="14"/>
          <TextBlock Text="Your music, offline." FontSize="34" FontWeight="SemiBold"/>
          <TextBlock Text="Windows-native Media Foundation + WASAPI" Foreground="{DynamicResource NeoMuted}"/>
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Songs}" MouseDoubleClick="SongList_DoubleClick">
          <ListBox.ItemTemplate><DataTemplate DataType="{x:Type models:Song}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource NeoMuted}" FontSize="12"/></StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Album}" VerticalAlignment="Center" Foreground="{DynamicResource NeoMuted}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="2" Text="{Binding PlayCount, StringFormat={}▶ {0}}" VerticalAlignment="Center" Foreground="{DynamicResource NeoMuted}"/>
              <StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="♥" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="⋯" Command="{Binding DataContext.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Grid Visibility="{Binding IsSearch, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="12" ToolTip="Search title, artist, album or genre"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" MouseDoubleClick="SongList_DoubleClick">
          <ListBox.ItemTemplate><DataTemplate DataType="{x:Type models:Song}"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Radio" Command="{Binding DataContext.SmartRadioCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Analyze" Command="{Binding DataContext.AnalyzeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource NeoMuted}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Grid Visibility="{Binding IsLibrary, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="12">
          <TextBlock Text="{DynamicResource Library}" FontSize="30" FontWeight="SemiBold" DockPanel.Dock="Left"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource AddFolder}" Command="{Binding AddSourceCommand}"/><Button Content="{DynamicResource Rescan}" Command="{Binding ScanCommand}"/></StackPanel>
        </DockPanel>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource NeoForeground}">
          <TabItem Header="Songs">
            <ListBox ItemsSource="{Binding Songs}" MouseDoubleClick="SongList_DoubleClick"><ListBox.ItemTemplate><DataTemplate><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="♥" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Hide" Command="{Binding DataContext.HideSongCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Radio" Command="{Binding DataContext.SmartRadioCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource NeoMuted}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          </TabItem>
          <TabItem Header="Albums"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Albums}"><ListBox.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><DockPanel><TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Foreground="{DynamicResource NeoMuted}"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DockPanel></Button></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Column="1"><TextBlock Text="{Binding SelectedCollectionTitle}" FontSize="20" FontWeight="SemiBold" Margin="10"/><ListBox ItemsSource="{Binding SelectedCollectionSongs}" MouseDoubleClick="SongList_DoubleClick" DisplayMemberPath="Title"/></StackPanel></Grid></TabItem>
          <TabItem Header="Artists"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Artists}"><ListBox.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><DockPanel><TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Foreground="{DynamicResource NeoMuted}"/><TextBlock Text="{Binding Name}"/></DockPanel></Button></DataTemplate></ListBox.ItemTemplate></ListBox><ListBox Grid.Column="1" ItemsSource="{Binding SelectedCollectionSongs}" MouseDoubleClick="SongList_DoubleClick" DisplayMemberPath="Title"/></Grid></TabItem>
          <TabItem Header="Genres"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Genres}"><ListBox.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><DockPanel><TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Foreground="{DynamicResource NeoMuted}"/><TextBlock Text="{Binding Name}"/></DockPanel></Button></DataTemplate></ListBox.ItemTemplate></ListBox><ListBox Grid.Column="1" ItemsSource="{Binding SelectedCollectionSongs}" MouseDoubleClick="SongList_DoubleClick" DisplayMemberPath="Title"/></Grid></TabItem>
          <TabItem Header="Folders"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Folders}"><ListBox.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><DockPanel><TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Foreground="{DynamicResource NeoMuted}"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DockPanel></Button></DataTemplate></ListBox.ItemTemplate></ListBox><ListBox Grid.Column="1" ItemsSource="{Binding SelectedCollectionSongs}" MouseDoubleClick="SongList_DoubleClick" DisplayMemberPath="Title"/></Grid></TabItem>
          <TabItem Header="Categories"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Create" Command="{Binding CreateCategoryCommand}"/><TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Category name"/></DockPanel><ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" DisplayMemberPath="Name"/><Button Content="Add current track" Command="{Binding AddCurrentToCategoryCommand}"/></StackPanel><ListBox Grid.Column="1" ItemsSource="{Binding SelectedCategorySongs}" MouseDoubleClick="SongList_DoubleClick" DisplayMemberPath="Title"/></Grid></TabItem>
          <TabItem Header="Hidden"><ListBox ItemsSource="{Binding HiddenSongs}"><ListBox.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="Unhide" Command="{Binding DataContext.UnhideSongCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource NeoMuted}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
        </TabControl>
      </Grid>

      <Grid Visibility="{Binding IsPlaylists, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="10"><TextBlock Text="Playlists" FontSize="30" FontWeight="SemiBold"/><DockPanel Margin="0,12,0,6"><Button DockPanel.Dock="Right" Content="Create" Command="{Binding CreatePlaylistCommand}"/><TextBox Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Playlist name"/></DockPanel><ListBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}" DisplayMemberPath="Name"/><StackPanel Orientation="Horizontal"><Button Content="Add current" Command="{Binding AddCurrentToPlaylistCommand}"/><Button Content="Delete" Command="{Binding DeletePlaylistCommand}"/></StackPanel><TextBlock Text="Folders" FontWeight="SemiBold" Margin="4,18,4,4"/><ListBox ItemsSource="{Binding PlaylistFolders}" DisplayMemberPath="Name" MaxHeight="150"/></StackPanel>
        <ListBox Grid.Column="1" Margin="10" ItemsSource="{Binding SelectedPlaylistSongs}" MouseDoubleClick="SongList_DoubleClick"><ListBox.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Command="{Binding DataContext.RemoveFromPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource NeoMuted}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid>

      <Grid Visibility="{Binding IsQueue, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="12"><TextBlock Text="Queue" FontSize="30" FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox Content="Shuffle" IsChecked="{Binding Shuffle, Mode=TwoWay}" VerticalAlignment="Center" Margin="8"/><Button Content="{Binding RepeatText}" Command="{Binding CycleRepeatCommand}"/><Button Content="Clear" Command="{Binding ClearQueueCommand}"/></StackPanel></DockPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Queue}" MouseDoubleClick="SongList_DoubleClick"><ListBox.ItemTemplate><DataTemplate><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="↑" Command="{Binding DataContext.MoveQueueUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="↓" Command="{Binding DataContext.MoveQueueDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Remove" Command="{Binding DataContext.RemoveQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource NeoMuted}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid>

      <Grid Visibility="{Binding IsLyrics, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Lyrics" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentLyric}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource NeoAccent}" TextWrapping="Wrap" Margin="0,8,0,8"/></StackPanel><TabControl Grid.Row="1"><TabItem Header="LRC"><TextBox Text="{Binding LyricsLrc, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="Plain"><TextBox Text="{Binding LyricsPlain, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="Translation"><TextBox Text="{Binding LyricsTranslation, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="Romanization"><TextBox Text="{Binding LyricsRomanization, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem></TabControl><StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="Import" Command="{Binding ImportLyricsCommand}"/><Button Content="Save" Command="{Binding SaveLyricsCommand}"/></StackPanel></Grid>
        <ScrollViewer Grid.Column="1"><StackPanel Margin="12"><TextBlock Text="Track metadata" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Title"/><TextBox Text="{Binding EditTitle}"/><TextBlock Text="Artist"/><TextBox Text="{Binding EditArtist}"/><TextBlock Text="Album"/><TextBox Text="{Binding EditAlbum}"/><TextBlock Text="Genre"/><TextBox Text="{Binding EditGenre}"/><TextBlock Text="Custom artwork"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Command="{Binding ChooseArtworkCommand}"/><TextBox Text="{Binding EditArtworkPath}"/></DockPanel><Button Content="Save metadata" Command="{Binding SaveMetadataCommand}" HorizontalAlignment="Left"/><Button Content="Open containing folder" Command="{Binding OpenContainingFolderCommand}" CommandParameter="{Binding CurrentSong}" HorizontalAlignment="Left"/><Button Content="Analyze track" Command="{Binding AnalyzeCommand}" CommandParameter="{Binding CurrentSong}" HorizontalAlignment="Left"/></StackPanel></ScrollViewer>
      </Grid>

      <Grid Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibility}}">
        <ScrollViewer><StackPanel Margin="18" MaxWidth="940" HorizontalAlignment="Left">
          <TextBlock Text="{DynamicResource Settings}" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,20"/>
          <TextBlock Text="Music sources" FontSize="18" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding Sources}" MinHeight="70"><ListBox.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <StackPanel Orientation="Horizontal"><Button Content="{DynamicResource AddFolder}" Command="{Binding AddSourceCommand}"/><Button Content="{DynamicResource Rescan}" Command="{Binding ScanCommand}"/></StackPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScanProgress, Mode=OneWay}" Height="6" Margin="4,8,4,20"/>

          <TextBlock Text="Excluded folders" FontSize="18" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding ExcludedSources}" MaxHeight="110"><ListBox.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Command="{Binding DataContext.RemoveExcludedSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="Exclude folder" Command="{Binding AddExcludedSourceCommand}" HorizontalAlignment="Left"/>

          <Separator Margin="0,14"/><TextBlock Text="Appearance &amp; Windows" FontSize="18" FontWeight="SemiBold"/>
          <WrapPanel><TextBlock Text="Theme" VerticalAlignment="Center" Margin="4"/><ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Width="130"/><TextBlock Text="Accent" VerticalAlignment="Center" Margin="12,4,4,4"/><ComboBox ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent, Mode=TwoWay}" Width="130"/><TextBlock Text="Language" VerticalAlignment="Center" Margin="12,4,4,4"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language, Mode=TwoWay}" Width="100"/></WrapPanel>
          <CheckBox Content="Start NEO Player with Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="4,8"/>

          <Separator Margin="0,14"/><TextBlock Text="Playback" FontSize="18" FontWeight="SemiBold"/>
          <WrapPanel><CheckBox Content="Crossfade" IsChecked="{Binding CrossfadeEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="4"/><TextBlock Text="Seconds" VerticalAlignment="Center" Margin="12,4,4,4"/><Slider Minimum="0" Maximum="15" Value="{Binding CrossfadeSeconds, Mode=TwoWay}" Width="180"/><CheckBox Content="Shuffle" IsChecked="{Binding Shuffle, Mode=TwoWay}" VerticalAlignment="Center" Margin="18,4"/><Button Content="{Binding RepeatText}" Command="{Binding CycleRepeatCommand}"/></WrapPanel>

          <TextBlock Text="Equalizer" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,4"/><ItemsControl ItemsSource="{Binding EqBands}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="58"><TextBlock Text="{Binding Label}" HorizontalAlignment="Center"/><Slider Orientation="Vertical" Minimum="-12" Maximum="12" Height="110" Value="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Gain, StringFormat={}{0:0.0}}" HorizontalAlignment="Center" FontSize="11"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <WrapPanel><TextBlock Text="Bass" VerticalAlignment="Center"/><Slider Minimum="-12" Maximum="12" Value="{Binding BassDb, Mode=TwoWay}" Width="180" Margin="6"/><TextBlock Text="Width" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="2" Value="{Binding StereoWidth, Mode=TwoWay}" Width="180" Margin="6"/><Button Content="Reset EQ" Command="{Binding ResetEqCommand}"/></WrapPanel>

          <Separator Margin="0,14"/><TextBlock Text="Sleep timer" FontSize="18" FontWeight="SemiBold"/><WrapPanel><TextBox Text="{Binding SleepMinutes}" Width="70"/><TextBlock Text="minutes" VerticalAlignment="Center" Margin="5"/><Button Content="Start" Command="{Binding StartSleepTimerCommand}"/><Button Content="Cancel" Command="{Binding CancelSleepTimerCommand}"/><TextBlock Text="{Binding SleepTimerText}" VerticalAlignment="Center" Margin="10" Foreground="{DynamicResource NeoMuted}"/></WrapPanel>

          <Separator Margin="0,14"/><TextBlock Text="Data" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Backup}" Command="{Binding BackupCommand}"/><Button Content="{DynamicResource Restore}" Command="{Binding RestoreCommand}"/></StackPanel>
          <TextBlock Text="Windows-native Media Foundation/WASAPI. No bundled FFmpeg or speech-model payloads." Foreground="{DynamicResource NeoMuted}" Margin="4,22" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource NeoPanel}" CornerRadius="18" Margin="0,10,0,0" Padding="16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding NowTitle}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding NowArtist}" Foreground="{DynamicResource NeoMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CurrentLyric}" Foreground="{DynamicResource NeoAccent}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="⏮" Command="{Binding PreviousCommand}"/><Button Content="⏯" Command="{Binding PlayPauseCommand}" Background="{DynamicResource NeoAccent}"/><Button Content="⏭" Command="{Binding NextCommand}"/></StackPanel><Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" PreviewMouseLeftButtonUp="SeekSlider_OnPreviewMouseLeftButtonUp" Margin="8,2"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="🔊" VerticalAlignment="Center"/><Slider Width="125" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"/></StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>