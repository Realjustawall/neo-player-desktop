<Window x:Class="NeoPlayer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NeoPlayer.Windows.Models"
        Title="NEO Player" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>

    <Border Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource NeoPanel}" CornerRadius="18" Padding="12" Margin="0,0,12,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="NEO" FontSize="30" FontWeight="Bold" Margin="10,8,10,22"/>
          <Button Content="{DynamicResource Home}" Command="{Binding HomeCommand}" HorizontalContentAlignment="Left"/>
          <Button Content="{DynamicResource Search}" Command="{Binding SearchPageCommand}" HorizontalContentAlignment="Left"/>
          <Button Content="{DynamicResource Library}" Command="{Binding LibraryCommand}" HorizontalContentAlignment="Left"/>
          <Button Content="{DynamicResource Settings}" Command="{Binding SettingsCommand}" HorizontalContentAlignment="Left"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource NeoMuted}" TextWrapping="Wrap" Margin="10"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Grid.Row="0">
      <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="12,4,12,18">
          <TextBlock Text="Good evening" Foreground="{DynamicResource NeoMuted}" FontSize="14"/>
          <TextBlock Text="Your music, offline." FontSize="34" FontWeight="SemiBold"/>
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Songs}" MouseDoubleClick="SongList_DoubleClick">
          <ListBox.ItemTemplate><DataTemplate DataType="{x:Type models:Song}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource NeoMuted}" FontSize="12"/></StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Album}" VerticalAlignment="Center" Foreground="{DynamicResource NeoMuted}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="2" Text="{Binding PlayCount, StringFormat={}▶ {0}}" VerticalAlignment="Center" Foreground="{DynamicResource NeoMuted}"/>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Grid Visibility="{Binding IsSearch, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="12" />
        <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" MouseDoubleClick="SongList_DoubleClick">
          <ListBox.ItemTemplate><DataTemplate DataType="{x:Type models:Song}"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource NeoMuted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Grid Visibility="{Binding IsLibrary, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="12">
          <TextBlock Text="{DynamicResource Library}" FontSize="30" FontWeight="SemiBold" DockPanel.Dock="Left"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource AddFolder}" Command="{Binding AddSourceCommand}"/><Button Content="{DynamicResource Rescan}" Command="{Binding ScanCommand}"/></StackPanel>
        </DockPanel>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource NeoForeground}">
          <TabItem Header="Songs"><ListBox ItemsSource="{Binding Songs}" MouseDoubleClick="SongList_DoubleClick"><ListBox.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="♥" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource NeoMuted}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
          <TabItem Header="Playlists"><StackPanel><Button Content="+ New playlist" Command="{Binding CreatePlaylistCommand}" HorizontalAlignment="Left"/><ListBox ItemsSource="{Binding Playlists}" DisplayMemberPath="Name"/></StackPanel></TabItem>
        </TabControl>
      </Grid>

      <Grid Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibility}}">
        <ScrollViewer><StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="{DynamicResource Settings}" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,20"/>
          <TextBlock Text="Music sources" FontSize="18" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding Sources}" MinHeight="70"/>
          <StackPanel Orientation="Horizontal"><Button Content="{DynamicResource AddFolder}" Command="{Binding AddSourceCommand}"/><Button Content="{DynamicResource Rescan}" Command="{Binding ScanCommand}"/></StackPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScanProgress}" Height="6" Margin="4,8,4,20"/>
          <TextBlock Text="Data" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Backup}" Command="{Binding BackupCommand}"/><Button Content="{DynamicResource Restore}" Command="{Binding RestoreCommand}"/></StackPanel>
          <TextBlock Text="Package design: Windows-native Media Foundation/WASAPI; no bundled FFmpeg or speech models." Foreground="{DynamicResource NeoMuted}" Margin="4,22" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource NeoPanel}" CornerRadius="18" Margin="0,10,0,0" Padding="16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding NowTitle}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding NowArtist}" Foreground="{DynamicResource NeoMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="⏮" Command="{Binding PreviousCommand}"/><Button Content="⏯" Command="{Binding PlayPauseCommand}" Background="{DynamicResource NeoAccent}"/><Button Content="⏭" Command="{Binding NextCommand}"/></StackPanel>
          <Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" PreviewMouseLeftButtonUp="SeekSlider_OnPreviewMouseLeftButtonUp" Margin="8,2"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="🔊" VerticalAlignment="Center"/><Slider Width="120" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"/></StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
