<Window x:Class="NeoPlayer.Windows.Views.AdvancedToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEO Player · Advanced Tools" Width="760" Height="620" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Advanced Tools" FontSize="28" FontWeight="SemiBold" Margin="4,0,4,14"/>
    <TabControl Grid.Row="1">
      <TabItem Header="Playlist folders">
        <Grid Margin="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Folders" FontSize="18" FontWeight="SemiBold"/>
            <ListBox x:Name="FolderList" Height="270" DisplayMemberPath="Name" SelectionChanged="FolderList_OnSelectionChanged"/>
            <TextBlock Text="New folder name" Margin="0,10,0,2"/><TextBox x:Name="FolderNameBox"/>
            <TextBlock Text="Parent (optional)" Margin="0,8,0,2"/><ComboBox x:Name="ParentFolderCombo" DisplayMemberPath="Name"/>
            <StackPanel Orientation="Horizontal"><Button Content="Create" Click="CreateFolder_Click"/><Button Content="Delete selected" Click="DeleteFolder_Click"/><Button Content="Move to root" Click="MoveFolderRoot_Click"/></StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Playlist placement" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Playlist" Margin="0,8,0,2"/><ComboBox x:Name="PlaylistCombo" DisplayMemberPath="Name" SelectionChanged="PlaylistCombo_OnSelectionChanged"/>
            <TextBlock Text="Destination folder" Margin="0,8,0,2"/><ComboBox x:Name="DestinationFolderCombo" DisplayMemberPath="Name"/>
            <StackPanel Orientation="Horizontal"><Button Content="Assign" Click="AssignPlaylist_Click"/><Button Content="Move to root" Click="UnassignPlaylist_Click"/></StackPanel>
            <Separator Margin="0,16"/>
            <TextBlock Text="M3U8" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Import standard UTF-8 M3U/M3U8 playlists and match tracks already present in the local library." TextWrapping="Wrap" Foreground="{DynamicResource NeoMuted}" Margin="0,4,0,8"/>
            <StackPanel Orientation="Horizontal"><Button Content="Import M3U8" Click="ImportM3u_Click"/><Button Content="Export selected" Click="ExportM3u_Click"/></StackPanel>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Playback">
        <StackPanel Margin="16" MaxWidth="600" HorizontalAlignment="Left">
          <TextBlock Text="Transitions & loudness" FontSize="20" FontWeight="SemiBold"/>
          <CheckBox x:Name="GaplessCheck" Content="Preload next track for gapless transitions" Checked="GaplessCheck_OnChanged" Unchecked="GaplessCheck_OnChanged" Margin="0,12,0,4"/>
          <CheckBox x:Name="NormalizeCheck" Content="Normalize loudness from local analysis cache" Checked="NormalizeCheck_OnChanged" Unchecked="NormalizeCheck_OnChanged" Margin="0,4"/>
          <TextBlock Text="Target loudness (LUFS)" Margin="0,14,0,2"/>
          <DockPanel><TextBlock x:Name="TargetLufsText" DockPanel.Dock="Right" Width="70" VerticalAlignment="Center"/><Slider x:Name="TargetLufsSlider" Minimum="-20" Maximum="-8" TickFrequency="1" IsSnapToTickEnabled="False" ValueChanged="TargetLufsSlider_OnValueChanged"/></DockPanel>
          <TextBlock Text="Normalization uses the cached LUFS/peak analysis and limits gain to available peak headroom to reduce clipping." TextWrapping="Wrap" Foreground="{DynamicResource NeoMuted}" Margin="0,10"/>
          <Separator Margin="0,12"/>
          <TextBlock Text="Crossfade remains controlled from Settings. When crossfade is off and Gapless is on, NEO preloads the next Media Foundation decoder before the boundary." TextWrapping="Wrap"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="4,12,4,0"><TextBlock x:Name="StatusText" Foreground="{DynamicResource NeoMuted}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"/></DockPanel>
  </Grid>
</Window>
