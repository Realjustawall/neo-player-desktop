<Window x:Class="NeoPlayer.Windows.Views.CompactPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEO Player Compact" Width="420" Height="170" MinWidth="360" MinHeight="150"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" Topmost="False">
  <Border Margin="10" Padding="14" Background="{DynamicResource NeoPanel}" CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding NowTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding NowArtist}" Foreground="{DynamicResource NeoMuted}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <Slider Grid.Row="1" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" Margin="0,10,0,6" PreviewMouseLeftButtonUp="Seek_OnPreviewMouseLeftButtonUp"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="⏮" Command="{Binding PreviousCommand}"/>
        <Button Content="⏯" Command="{Binding PlayPauseCommand}" Background="{DynamicResource NeoAccent}"/>
        <Button Content="⏭" Command="{Binding NextCommand}"/>
        <Button Content="Queue" Command="{Binding QueuePageCommand}"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
